{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "baseUrl": "./src",
    "paths": {
      "@/*": ["./*"],
      "@components/*": ["components/*"],
      "@pages/*": ["pages/*"],
      "@hooks/*": ["hooks/*"],
      "@services/*": ["services/*"],
      "@utils/*": ["utils/*"],
      "@constants/*": ["constants/*"],
      "@app-types/*": ["types/*"],
      "@stores/*": ["stores/*"],
      "@assets/*": ["assets/*"],
      "@styles/*": ["styles/*"],
      "@routes/*": ["routes/*"],
      "@base/*": ["base/*"],
      "@features/*": ["features/*"]
    },
    "noImplicitAny": false,
    "noEmit": true
  },
  "include": ["src"]
}
